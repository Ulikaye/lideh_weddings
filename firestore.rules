rules_version = '2';

// This app gates access with an in-app username/password screen, NOT
// Firebase Authentication, so Firestore has no `request.auth` to check -
// these rules are intentionally open so the app works out of the box.
// That means anyone with your web/API config could read or write this
// data directly, bypassing the login screen.
//
// Before this goes anywhere public, switch to Firebase Authentication
// (email/password is enough) and lock these down to something like:
//   allow read, write: if request.auth != null;
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
